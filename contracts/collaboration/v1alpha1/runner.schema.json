{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reasoning.invalid/collaboration/v1alpha1/runner.schema.json",
  "title": "Reasoning Contributed Desktop Runner",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "organization_id", "runner_id", "owner",
    "display_name", "state", "capabilities", "policy", "last_seen_at"
  ],
  "properties": {
    "schema_id": {"const": "reasoning.collaboration.runner"},
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "organization_id": {"$ref": "common.schema.json#/$defs/stableId"},
    "runner_id": {"$ref": "common.schema.json#/$defs/stableId"},
    "owner": {"$ref": "common.schema.json#/$defs/actor"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
    "state": {"enum": ["available", "busy", "paused", "offline"]},
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness_ids", "models", "reasoning_efforts", "max_concurrency"],
      "properties": {
        "harness_ids": {
          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}
        },
        "models": {
          "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        },
        "reasoning_efforts": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["none", "low", "medium", "high", "xhigh", "max", "ultra"]}
        },
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 16}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_ids", "network_access", "requires_local_approval"],
      "properties": {
        "workspace_ids": {
          "type": "array", "maxItems": 256, "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/stableId"}
        },
        "network_access": {"enum": ["denied", "allowlisted", "unrestricted"]},
        "requires_local_approval": {"type": "boolean"}
      }
    },
    "last_seen_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}

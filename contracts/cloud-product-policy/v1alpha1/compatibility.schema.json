{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reasoning.invalid/cloud-product-policy/v1alpha1/compatibility.schema.json",
  "title": "Reasoning Cloud Product Policy Compatibility",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "family", "contracts", "dependencies", "rules"],
  "properties": {
    "schema_id": {"const": "reasoning.cloud-product-policy.compatibility"},
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "family": {"const": "reasoning-cloud-product-policy-v1alpha1"},
    "contracts": {
      "const": [
        {"schema_id": "reasoning.cloud-product-policy.account-policy", "version": "1.0.0-alpha.1", "schema_path": "account-policy.schema.json"},
        {"schema_id": "reasoning.cloud-product-policy.optional-use-change", "version": "1.0.0-alpha.1", "schema_path": "optional-use-change.schema.json"}
      ]
    },
    "dependencies": {
      "const": [
        {
          "id": "cloud-client",
          "version": "1.0.0-alpha.1",
          "path": "contracts/cloud-client/v1alpha1/bundle-manifest.json",
          "digest": "sha256:5c858b9346cfc796c50c7e2cc48ffee2d6c61334fc14f63d7ba24f46522e8bf3",
          "internal_bundle_digest": "sha256:58f45ca5f9e5a53382b40444399e4cc792d297ead59b6387fd482ab72e0ad6b7"
        }
      ]
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prerelease_negotiation",
        "unknown_schema",
        "unknown_required_field",
        "dependency_records",
        "scope_authority",
        "offer_reference",
        "offer_axes",
        "price_defaults",
        "limit_defaults",
        "optional_use_default",
        "optional_use_independence",
        "historical_withdrawal",
        "required_telemetry_independence",
        "replay_order",
        "replay_result",
        "cas_order",
        "mutation_atomicity",
        "client_equivalence",
        "digest_canonicalization",
        "digest_encoding",
        "digest_algorithm"
      ],
      "properties": {
        "prerelease_negotiation": {"const": "exact_version"},
        "unknown_schema": {"const": "reject"},
        "unknown_required_field": {"const": "reject"},
        "dependency_records": {"const": "reference_exact_canonical_bytes_never_redefine"},
        "scope_authority": {"const": "connected_session_plus_separate_account_authority"},
        "offer_reference": {"const": "exact_capability_descriptor_identity_and_accepted_byte_digest"},
        "offer_axes": {"const": "inference_and_compute_independent"},
        "price_defaults": {"const": "missing_is_never_zero"},
        "limit_defaults": {"const": "missing_is_never_unbounded"},
        "optional_use_default": {"const": "all_off"},
        "optional_use_independence": {"const": "one_purpose_per_transition"},
        "historical_withdrawal": {"const": "permitted_against_exact_grant_policy_when_current_offer_unavailable"},
        "required_telemetry_independence": {"const": "never_mutated_by_optional_use"},
        "replay_order": {"const": "strict_key_scope_and_request_validation_then_locked_exact_lookup_before_current_state_cas"},
        "replay_result": {"const": "original_exact_accepted_snapshot_bytes"},
        "cas_order": {"const": "snapshot_capability_entitlement_product_policy_then_purpose_decision"},
        "mutation_atomicity": {"const": "one_transition_or_no_change"},
        "client_equivalence": {"const": "browser_and_desktop_share_store_without_public_client_class"},
        "digest_canonicalization": {"const": "RFC 8785 JSON Canonicalization Scheme"},
        "digest_encoding": {"const": "UTF-8"},
        "digest_algorithm": {"const": "SHA-256"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reasoning.invalid/executor/v1alpha1/provenance.schema.json",
  "title": "Reasoning Executor Provenance",
  "description": "The reproducibility and execution record for a completed or reconciled job.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "provenance_id",
    "job_id",
    "executor",
    "environment",
    "components",
    "input_digests",
    "output_digests",
    "resource_usage",
    "network_policy",
    "started_at",
    "finished_at",
    "outcome"
  ],
  "properties": {
    "schema_id": {"const": "reasoning.executor.provenance"},
    "schema_version": {"const": "1.0.0-alpha.1"},
    "provenance_id": {"type": "string", "pattern": "^provenance_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "job_id": {"type": "string", "pattern": "^job_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "target_kind", "target_id"],
      "properties": {
        "adapter_id": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1},
        "target_kind": {"enum": ["fake", "local", "modal", "aws"]},
        "target_id": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image_digest", "capabilities_digest", "attestation_digest", "runner_version"],
      "properties": {
        "image_digest": {"$ref": "#/$defs/digest"},
        "capabilities_digest": {"$ref": "#/$defs/digest"},
        "attestation_digest": {"$ref": "#/$defs/digest"},
        "runner_version": {"type": "string", "minLength": 1}
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
          "digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "input_digests": {"$ref": "#/$defs/digestList"},
    "output_digests": {"$ref": "#/$defs/digestList"},
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_seconds", "peak_memory_bytes", "wall_time_seconds", "artifact_bytes"],
      "properties": {
        "cpu_seconds": {"type": "number", "minimum": 0},
        "peak_memory_bytes": {"type": "integer", "minimum": 0},
        "wall_time_seconds": {"type": "number", "minimum": 0},
        "artifact_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowed_destinations"],
      "properties": {
        "mode": {"enum": ["denied", "allowlist"]},
        "allowed_destinations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "outcome": {"enum": ["succeeded", "failed", "cancelled", "outcome_unknown"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "digestList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    }
  }
}

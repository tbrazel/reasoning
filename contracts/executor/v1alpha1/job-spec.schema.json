{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reasoning.invalid/executor/v1alpha1/job-spec.schema.json",
  "title": "Reasoning Executor Job Specification",
  "description": "An immutable, policy-complete computation request accepted by an Executor adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "job_id",
    "actor",
    "tenant_id",
    "project_id",
    "run_id",
    "step_id",
    "idempotency_key",
    "submitted_at",
    "executor",
    "image",
    "command",
    "inputs",
    "resources",
    "deadline",
    "cancellation",
    "network_policy",
    "outputs",
    "log_policy",
    "workload_identity",
    "provenance_required"
  ],
  "properties": {
    "schema_id": {"const": "reasoning.executor.job-spec"},
    "schema_version": {"const": "1.0.0-alpha.1"},
    "job_id": {"$ref": "#/$defs/jobId"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["user", "service", "harness"]},
        "id": {"$ref": "#/$defs/scopedId"}
      }
    },
    "tenant_id": {"$ref": "#/$defs/scopedId"},
    "project_id": {"$ref": "#/$defs/scopedId"},
    "run_id": {"$ref": "#/$defs/scopedId"},
    "step_id": {"$ref": "#/$defs/scopedId"},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 255},
    "submitted_at": {"type": "string", "format": "date-time"},
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "target_kind", "target_id"],
      "properties": {
        "adapter_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "target_kind": {"enum": ["fake", "local", "modal", "aws"]},
        "target_id": {"type": "string", "minLength": 1, "maxLength": 255}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "capabilities_digest", "attestation_digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "maxLength": 255},
        "digest": {"$ref": "#/$defs/digest"},
        "capabilities_digest": {"$ref": "#/$defs/digest"},
        "attestation_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "working_directory"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"type": "string", "maxLength": 8192}
        },
        "working_directory": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "inputs": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "digest", "mount_path", "read_only"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^artifact_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "digest": {"$ref": "#/$defs/digest"},
          "mount_path": {"$ref": "#/$defs/absolutePath"},
          "read_only": {"const": true}
        }
      }
    },
    "resources": {"$ref": "#/$defs/resourceSet"},
    "deadline": {"type": "string", "format": "date-time"},
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "grace_period_seconds"],
      "properties": {
        "mode": {"enum": ["graceful_then_kill", "kill"]},
        "grace_period_seconds": {"type": "integer", "minimum": 0, "maximum": 300}
      }
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowed_destinations"],
      "properties": {
        "mode": {"enum": ["denied", "allowlist"]},
        "allowed_destinations": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 255}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "denied"}}},
          "then": {"properties": {"allowed_destinations": {"maxItems": 0}}}
        }
      ]
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "media_type", "required", "max_bytes"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 255},
          "path": {"$ref": "#/$defs/absolutePath"},
          "media_type": {"type": "string", "minLength": 1, "maxLength": 255},
          "required": {"type": "boolean"},
          "max_bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "log_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_stdout", "capture_stderr", "max_bytes"],
      "properties": {
        "capture_stdout": {"type": "boolean"},
        "capture_stderr": {"type": "boolean"},
        "max_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "workload_identity": {
      "type": "object",
      "description": "A reference to an audience-restricted workload credential, never the credential value itself.",
      "additionalProperties": false,
      "required": ["audience", "credential_reference", "expires_at"],
      "properties": {
        "audience": {"type": "string", "minLength": 1, "maxLength": 255},
        "credential_reference": {"type": "string", "minLength": 1, "maxLength": 1024},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "provenance_required": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "executor",
          "image",
          "capabilities",
          "components",
          "inputs",
          "outputs",
          "resource_usage",
          "network_policy",
          "timestamps",
          "outcome"
        ]
      }
    }
  },
  "$defs": {
    "jobId": {"type": "string", "pattern": "^job_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "scopedId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "absolutePath": {"type": "string", "pattern": "^/"},
    "resourceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory_bytes", "disk_bytes", "pids", "wall_time_seconds", "artifact_bytes"],
      "properties": {
        "cpu": {"type": "number", "exclusiveMinimum": 0},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "disk_bytes": {"type": "integer", "minimum": 1},
        "pids": {"type": "integer", "minimum": 1},
        "wall_time_seconds": {"type": "integer", "minimum": 1},
        "artifact_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}

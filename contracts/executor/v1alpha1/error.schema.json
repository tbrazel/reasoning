{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reasoning.invalid/executor/v1alpha1/error.schema.json",
  "title": "Reasoning Executor Error",
  "description": "A sanitized, machine-readable execution error. Details must not contain credentials or secret material.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "code", "category", "message", "retryable", "occurred_at"],
  "properties": {
    "schema_id": {"const": "reasoning.executor.error"},
    "schema_version": {"const": "1.0.0-alpha.1"},
    "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "category": {
      "enum": ["validation", "policy", "dispatch", "execution", "infrastructure", "cancellation", "integrity", "unknown"]
    },
    "message": {"type": "string", "minLength": 1, "maxLength": 4096},
    "retryable": {"type": "boolean"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "event_id": {"type": "string", "pattern": "^event_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "details": {
      "type": "object",
      "description": "Sanitized diagnostic fields only.",
      "maxProperties": 32,
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "null"]
      }
    }
  }
}

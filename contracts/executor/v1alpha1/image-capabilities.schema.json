{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reasoning.invalid/executor/v1alpha1/image-capabilities.schema.json",
  "title": "Reasoning Execution Image Capabilities",
  "description": "Build-generated facts embedded at /etc/reasoning/capabilities.json. The final OCI image digest is intentionally excluded to avoid a circular digest dependency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "manifest_scope",
    "image_name",
    "build_timestamp",
    "source_revision",
    "platform",
    "runtimes",
    "tools",
    "compatibility",
    "paths",
    "resource_limits",
    "network",
    "devices",
    "restrictions",
    "sbom"
  ],
  "properties": {
    "schema_id": {"const": "reasoning.executor.image-capabilities"},
    "schema_version": {"const": "1.0.0-alpha.1"},
    "manifest_scope": {"const": "installed"},
    "image_name": {"type": "string", "minLength": 1, "maxLength": 255},
    "build_timestamp": {"type": "string", "format": "date-time"},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "architecture": {"enum": ["amd64", "arm64"]}
      }
    },
    "runtimes": {
      "type": "array",
      "items": {"$ref": "#/$defs/versionedComponent"},
      "uniqueItems": true
    },
    "tools": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/versionedComponent"},
          {
            "type": "object",
            "required": ["entry_points", "operations"],
            "properties": {
              "entry_points": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "operations": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "documentation": {"type": "string", "format": "uri"}
            }
          }
        ]
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor_contract", "runner"],
      "properties": {
        "executor_contract": {"const": "1.0.0-alpha.1"},
        "runner": {"type": "string", "minLength": 1},
        "noether": {"type": "string", "minLength": 1}
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["working", "input", "output", "cache", "temporary"],
      "properties": {
        "working": {"$ref": "#/$defs/absolutePath"},
        "input": {"$ref": "#/$defs/absolutePath"},
        "output": {"$ref": "#/$defs/absolutePath"},
        "cache": {"$ref": "#/$defs/absolutePath"},
        "temporary": {"$ref": "#/$defs/absolutePath"}
      }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaults", "maximums"],
      "properties": {
        "defaults": {"$ref": "#/$defs/resourceSet"},
        "maximums": {"$ref": "#/$defs/resourceSet"}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported_modes"],
      "properties": {
        "supported_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["denied", "allowlist"]}
        },
        "possible_destinations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "devices": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "restrictions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "path"],
      "properties": {
        "format": {"enum": ["spdx-json", "cyclonedx-json"]},
        "path": {"$ref": "#/$defs/absolutePath"}
      }
    }
  },
  "$defs": {
    "absolutePath": {"type": "string", "pattern": "^/"},
    "versionedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "entry_points": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "documentation": {"type": "string", "format": "uri"}
      }
    },
    "resourceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory_bytes", "disk_bytes", "pids", "wall_time_seconds", "artifact_bytes"],
      "properties": {
        "cpu": {"type": "number", "exclusiveMinimum": 0},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "disk_bytes": {"type": "integer", "minimum": 1},
        "pids": {"type": "integer", "minimum": 1},
        "wall_time_seconds": {"type": "integer", "minimum": 1},
        "artifact_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}

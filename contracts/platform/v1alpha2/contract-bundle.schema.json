{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reasoning.invalid/platform/v1alpha2/contract-bundle.schema.json",
  "title": "Reasoning Platform Contract Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "bundle_id",
    "canonicalization",
    "encoding",
    "hash_algorithm",
    "members",
    "bundle_digest"
  ],
  "properties": {
    "schema_id": {"const": "reasoning.platform.contract-bundle"},
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "bundle_id": {"const": "reasoning-platform-v1alpha2"},
    "canonicalization": {"const": "RFC 8785 JSON Canonicalization Scheme"},
    "encoding": {"const": "UTF-8"},
    "hash_algorithm": {"const": "SHA-256"},
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": {"$ref": "common.schema.json#/$defs/relativePath"},
          "digest": {"$ref": "common.schema.json#/$defs/digest"}
        }
      }
    },
    "bundle_digest": {"$ref": "common.schema.json#/$defs/digest"}
  }
}

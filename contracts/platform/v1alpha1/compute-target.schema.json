{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reasoning.invalid/platform/v1alpha1/compute-target.schema.json",
  "title": "Reasoning Compute Target",
  "description": "A computation target projected from ExecutionTargetCapabilities and an Executor adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "target_id",
    "display_name",
    "location",
    "kind",
    "isolation",
    "workspace_access",
    "network_access",
    "supports_processes",
    "durable_workspace",
    "executor",
    "supported_harness_ids",
    "pricing_catalog_id"
  ],
  "properties": {
    "schema_id": {"const": "reasoning.platform.compute-target"},
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "target_id": {"type": "string", "pattern": "^target_[A-Za-z0-9._-]{3,127}$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 255},
    "location": {"$ref": "common.schema.json#/$defs/location"},
    "kind": {"enum": ["host", "local_sandbox", "remote_sandbox", "stateless"]},
    "isolation": {"enum": ["none", "process", "os_sandbox", "container", "vm"]},
    "workspace_access": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["none", "read_only", "read_write"]}
    },
    "network_access": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["denied", "allowlisted", "unrestricted"]}
    },
    "supports_processes": {"type": "boolean"},
    "durable_workspace": {"type": "boolean"},
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "target_kind", "contract_version"],
      "properties": {
        "adapter_id": {"$ref": "common.schema.json#/$defs/stableId"},
        "adapter_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "target_kind": {"enum": ["fake", "local", "modal", "aws"]},
        "contract_version": {"const": "1.0.0-alpha.1"}
      }
    },
    "supported_harness_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}
    },
    "pricing_catalog_id": {"$ref": "common.schema.json#/$defs/stableId"}
  }
}

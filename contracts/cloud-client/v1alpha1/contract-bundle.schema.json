{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.reasoning.invalid/cloud-client/v1alpha1/contract-bundle.schema.json",
  "title": "Reasoning Cloud Client Contract Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "bundle_id",
    "canonicalization",
    "encoding",
    "hash_algorithm",
    "members",
    "dependencies",
    "bundle_digest"
  ],
  "properties": {
    "schema_id": {"const": "reasoning.cloud-client.contract-bundle"},
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "bundle_id": {"const": "reasoning-cloud-client-v1alpha1"},
    "canonicalization": {"const": "RFC 8785 JSON Canonicalization Scheme"},
    "encoding": {"const": "UTF-8"},
    "hash_algorithm": {"const": "SHA-256"},
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": {"type": "string", "pattern": "^(contracts|conformance)/[A-Za-z0-9._/-]+$"},
          "digest": {"$ref": "common.schema.json#/$defs/digest"}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {"$ref": "common.schema.json#/$defs/dependency"}
    },
    "bundle_digest": {"$ref": "common.schema.json#/$defs/digest"}
  }
}

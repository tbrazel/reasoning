{
  "schema_id": "reasoning.platform.harness-provider",
  "schema_version": "1.0.0-alpha.1",
  "descriptor_id": "harness_provider_codex_local",
  "harness_id": "codex",
  "display_name": "Codex app-server",
  "location": "local",
  "transport": "local_process",
  "adapter_version": "1",
  "protocol_version": "1",
  "event_version": "1",
  "session": {
    "modes": ["fresh", "resume"],
    "durability": "device",
    "reconnect": {
      "supported": true,
      "cursor": "opaque",
      "after": "exclusive",
      "delivery": "at_least_once",
      "deduplicate_by": "event_id"
    }
  },
  "features": {
    "streaming": true,
    "tools": true,
    "skills": true,
    "structured_output": true,
    "mcp": true,
    "approvals": true,
    "interrupt": true,
    "steering": true,
    "checkpoints": false,
    "subagents": true,
    "context_compaction": true,
    "reports_usage": true,
    "reports_cost": false,
    "reasoning_visibility": "streamed_summary",

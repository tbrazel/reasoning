  "supported_inference_route_ids": ["route_local_ollama", "route_cloud_openrouter"],
  "supported_compute_target_ids": ["target_local_container", "target_cloud_research_cpu"],
  "credential_custody": {
    "account_material": "device_local",
    "inference_material": "route_scoped",
    "reusable_material_exported": false
  },
  "limitations": ["Portable handoff excludes provider-private session state."],
  "conformance": {
    "suite_version": "1.0.0-alpha.1",
    "status": "partial",
    "verified_capabilities": ["fresh", "resume", "streaming", "tools", "approvals", "interrupt", "steering"]
  }

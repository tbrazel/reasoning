{
  "schema_id": "reasoning.platform.negative-cases",
  "schema_version": "1.0.0-alpha.1",
  "cases": [
    {
      "id": "project-link-cannot-appear-without-link-approval",
      "schema": "project-bundle.schema.json",
      "base": "positive/project-bundle.local-unlinked.json",
      "validation": "schema",
      "mutations": [
        {"op": "replace", "pointer": "/linkage", "value": {"state": "linked"}}
      ]
    },
    {
      "id": "portable-project-export-rejects-secret-fields",
      "schema": "project-bundle.schema.json",
      "base": "positive/project-bundle.local-unlinked.json",
      "validation": "schema",
      "mutations": [
        {"op": "add", "pointer": "/refresh_token", "value": "must-not-export"}
      ]
    },
    {
      "id": "project-link-approval-binds-exact-policy",
      "schema": "project-bundle.schema.json",
      "base": "positive/project-bundle.local-linked.json",
      "validation": "project_semantic",
      "mutations": [
        {"op": "replace", "pointer": "/linkage/authorized_data_classes/0", "value": "workflow_records"}
      ]
    },
    {
      "id": "route-plan-rejects-opaque-backend-selection",
      "schema": "route-plan.schema.json",
      "base": "positive/route-plan.lhh.json",
      "validation": "schema",
      "mutations": [
        {"op": "add", "pointer": "/backend", "value": "magic"}
      ]
    },
    {
      "id": "prerelease-negotiation-requires-exact-version",
      "schema": "route-plan.schema.json",
      "base": "positive/route-plan.lhh.json",
      "validation": "schema",
      "mutations": [
        {"op": "replace", "pointer": "/schema_version", "value": "1.0.0-alpha.2"}
      ]
    },
    {

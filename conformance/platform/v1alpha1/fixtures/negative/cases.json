      "schema": "route-plan.schema.json",
      "base": "positive/route-plan.lhh.json",
      "validation": "schema",
      "mutations": [
        {"op": "remove", "pointer": "/persistence/transfer_manifest_id"}
      ]
    },
    {
      "id": "local-harness-hosted-compute-requires-connector",
      "schema": "route-plan.schema.json",
      "base": "positive/route-plan.lhh.json",
      "validation": "schema",
      "mutations": [
        {"op": "remove", "pointer": "/compute/connector_grant_id"}
      ]
    },
    {
      "id": "hosted-route-rejects-unrelated-transfer-id",
      "schema": "route-plan.schema.json",
      "base": "positive/route-plan.lhh.json",
      "validation": "route_semantic",
      "mutations": [
        {"op": "replace", "pointer": "/persistence/transfer_manifest_id", "value": "transfer_unrelated_001"}
      ]
